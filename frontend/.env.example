# ============================================================
# AutoBuy frontend — environment configuration
# Copy to `.env.local` and fill in. NEVER commit the real file.
# ============================================================

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Razorpay TEST-mode publishable key id (safe to expose to the browser).
# Must match RAZORPAY_KEY_ID in the backend .env.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
