# ============================================================
# AutoBuy backend — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================

# ---- App ----
APP_NAME=AutoBuy
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Local default (zero infra required):
DATABASE_URL=sqlite+aiosqlite:///./autobuy.db
# Postgres (docker-compose / Render / Neon). Paste the provider's URL as-is —
# `postgres://` and `postgresql://` are rewritten to the asyncpg driver, and
# libpq-only parameters (`sslmode`, `channel_binding`) are translated or
# dropped, because asyncpg rejects them.
# DATABASE_URL=postgresql://autobuy:autobuy@localhost:5432/autobuy
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/autobuy?sslmode=require

# Force PgBouncer-safe connection settings when the pooled host does not
# advertise itself with "-pooler" (Supabase's pooler, for instance).
# PGBOUNCER_MODE=true

# ---- Redis (idempotency keys + rate limiting) ----
# Optional locally; unset falls back to an in-process store.
# REDIS_URL=redis://localhost:6379/0

# ---- Razorpay — TEST MODE ONLY ----
# Get these from https://dashboard.razorpay.com → Settings → API Keys
# (make sure the dashboard toggle is on "Test Mode").
# The app REFUSES TO START if the key id is not a rzp_test_ key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_CURRENCY=INR

# ---- Anthropic (agent reasoning) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=4096
# Thinking depth vs. latency/cost: low | medium | high | xhigh | max.
# Spend caps are enforced server-side, so effort is never what keeps a
# purchase safe — it only affects answer quality.
ANTHROPIC_EFFORT=medium
# Intent classification (a 5-way label, never a money decision) is routed to a
# cheap, fast model instead of the one the buyer is talking to — see
# app/services/llm_usage.py for the measured cost difference. Must have a
# pricing entry in MODEL_PRICING there.
ANTHROPIC_INTENT_MODEL=claude-haiku-4-5

# ---- Agent ----
# Which brain drives the conversation:
#   model     — Claude (needs a funded ANTHROPIC_API_KEY)
#   scripted  — a deterministic keyword planner, no model call, no API credit
#
# Scripted mode changes ONLY the conversational surface. Guardrails, the
# approval gate, the audit trail, retry, idempotency and the live Razorpay calls
# are identical either way — which is the point: the safety properties do not
# depend on the model. The UI badges every scripted turn.
AGENT_MODE=model

# Maximum tool-calling rounds in a single chat turn. A model that keeps calling
# tools terminates at this ceiling instead of spinning.
AGENT_MAX_ITERATIONS=8

# ---- Retry ----
# A retryable provider failure is retried once. Deliberately once: a payment
# gateway that is failing rarely recovers in milliseconds, and every extra
# attempt widens the window in which a charge could land twice.
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_RETRY_BASE_DELAY=0.5

# ---- Consent lifecycle ----
# Require an explicit, unexpired grant before the agent may spend at all.
# On by default: purchasing authority a buyer never gave is not something
# anyone should have to opt out of. Grant one from the merchant dashboard.
REQUIRE_AGENT_GRANT=true
# Defaults offered by the dashboard's grant control.
DEFAULT_GRANT_CAP_MINOR=500000     # ₹5,000.00
DEFAULT_GRANT_HOURS=24

# ---- Guardrails (amounts in minor units — paise for INR) ----
# Orders at or below this execute without human approval.
AUTO_APPROVE_LIMIT_MINOR=50000
# Hard ceiling for any single transaction. Above this the agent is blocked.
PER_TRANSACTION_CAP_MINOR=200000
# Rolling 24h cumulative ceiling across all agent spend.
DAILY_CAP_MINOR=1000000
